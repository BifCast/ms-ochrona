{% extends 'base.html.twig' %}

{% block title %}Logowanie{% endblock %}

{% block body %}
<form method="post">
    {% if error %}
        <div class="alert alert-danger">{{error.messageKey|trans(error.messageData, 'security')}}</div>
    {% endif %}

    <h1 class="h3 mb-3 font-weight-normal">Zaloguj się</h1>
    <label for="inputEmail">Email lub login</label>
    <input type="string" value="{{last_username}}" name="email" id="inputEmail" class="form-control" required autofocus><br>
    <label for="inputPassword">Hasło</label>
    <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{csrf_token('authenticate')}}">

    <button class="btn btn-lg btn-primary" type="submit">Zaloguj</button>
</form>
{% endblock %}
